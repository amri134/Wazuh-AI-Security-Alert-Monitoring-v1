# WAZUH
WAZUH_URL=https://your-wazuh-instance.example.com
WAZUH_USERNAME=your_username
WAZUH_PASSWORD=your_password

WAZUH_POLL_INTERVAL=10
WAZUH_QUERY_WINDOW_MINUTES=5
WAZUH_QUERY_LIMIT=100
WAZUH_HEADLESS=false

# TELEGRAM
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# GEMINI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your_model_name

GEMINI_MAX_OUTPUT_TOKENS=2500
GEMINI_THINKING_LEVEL=low
GEMINI_RETRY_COUNT=2
GEMINI_CACHE_TTL_DAYS=30
GEMINI_CACHE_MAX_ENTRIES=1000